{
  "$meta": {
    "name": "Shotforge",
    "base": "Klyro design system — surfaces, type, spacing, radii, motion, focus, status",
    "own": "name, logo, ember accent; no Branch motif, no volt",
    "note": "Neutral surfaces only around frames and video, so skin and grade read true."
  },
  "color": {
    "canvas": "#0b0c0e",
    "surface": "#13151a",
    "surface-raised": "#1b1e25",
    "surface-overlay": "#232732",
    "surface-neutral": "#141414",
    "border": "#2b303b",
    "border-strong": "#3a4150",
    "text": "#e8eaef",
    "text-muted": "#a3abb9",
    "text-faint": "#6e7686",
    "accent": "#f2653a",
    "accent-hover": "#ff7c52",
    "accent-quiet": "#2a1711",
    "accent-text": "#120a07",
    "status-pass": "#4bb87a",
    "status-warn": "#e0a33a",
    "status-fail": "#e2574b",
    "status-idle": "#6e7686",
    "status-active": "#4a9ad4"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "pill": "999px"
  },
  "font": {
    "sans": "'Instrument Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "condensed": "'Instrument Sans Condensed', 'Instrument Sans', system-ui, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, 'SF Mono', Consolas, monospace",
    "size-xs": "11px",
    "size-sm": "13px",
    "size-md": "15px",
    "size-lg": "19px",
    "size-xl": "25px",
    "weight-regular": "400",
    "weight-medium": "500",
    "weight-bold": "700",
    "leading-tight": "1.25",
    "leading-normal": "1.5"
  },
  "motion": {
    "fast": "120ms",
    "normal": "200ms",
    "slow": "320ms",
    "ease": "cubic-bezier(0.2, 0, 0.2, 1)"
  },
  "shadow": {
    "raised": "0 1px 2px rgba(0,0,0,0.4)",
    "overlay": "0 12px 32px rgba(0,0,0,0.5)"
  },
  "ring": {
    "width": "2px",
    "offset": "2px"
  }
}
